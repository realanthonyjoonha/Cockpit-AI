{
  "name": "memory-cockpit-v2",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "start": "node server/index.js",
    "start:lan": "HOST=0.0.0.0 node server/index.js",
    "serve": "npm run build && node server/index.js",
    "smoke": "node scripts/thin-desk-format-check.mjs && node scripts/smoke.mjs",
    "smoke:api": "node scripts/smoke.mjs",
    "smoke:render": "node scripts/smoke.mjs -- --render",
    "smoke:rigor": "node scripts/thin-desk-format-check.mjs && node scripts/thin-desk-rigor.mjs",
    "test:thin": "node scripts/thin-desk-format-check.mjs && node scripts/thin-desk-rigor.mjs && node scripts/smoke.mjs -- --render",
    "format-check": "node scripts/thin-desk-format-check.mjs",
    "write-path-drill": "node scripts/write-path-drill.mjs",
    "test:accept-assert": "node scripts/accept-write-assert-test.mjs",
    "test:open-grok-prompt": "node scripts/open-grok-prompt-test.mjs",
    "test:pack-cache": "node scripts/pack-cache-test.mjs",
    "test:live-registry": "node scripts/live-registry-test.mjs",
    "test:street": "node scripts/street-schema-test.mjs && node scripts/thin-street-test.mjs",
    "test:platform": "node scripts/live-registry-test.mjs && node scripts/pack-cache-test.mjs && node scripts/open-grok-prompt-test.mjs && node scripts/thin-street-test.mjs",
    "propose-nbis": "node scripts/propose-nbis.mjs",
    "agent:mcp-install": "node scripts/agent-mcp-install.mjs",
    "grok:mcp-install": "node scripts/grok-mcp-install.mjs",
    "claude:mcp-install": "node scripts/claude-mcp-install.mjs",
    "mcp:cockpit": "node scripts/mcp-cockpit-research.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dompurify": "^3.4.11",
    "express": "^4.21.0",
    "lightweight-charts": "^5.2.0",
    "marked": "^15.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "vite": "^6.0.0"
  }
}
