{
  "version": "3",
  "comment": "Universal filing spine. First matching rule wins. Phrases are whole words. No issuer, product, geography, or sector names. Desk N must match with no rule edits.",
  "boilerplate": [
    "central index key",
    "commission file number",
    "incorporated in",
    "state of delaware",
    "common stock is listed",
    "trading symbol",
    "nasdaq global",
    "new york stock exchange",
    "principal executive offices",
    "irs employer",
    "registrant's telephone",
    "title of each class",
    "exact name of registrant"
  ],
  "metrics": [
    {
      "id": "goodwill_impairment",
      "all": ["goodwill", "impairment"]
    },
    {
      "id": "impairment",
      "any": ["impairment", "impairments"]
    },
    {
      "id": "goodwill",
      "any": ["goodwill"],
      "none": ["impairment", "impairments"]
    },
    {
      "id": "inventory",
      "any": ["inventory", "inventories"],
      "none": ["impairment", "impairments"]
    },
    {
      "id": "operating_cash_flow",
      "any": [
        "operating activities",
        "operating cash flow",
        "operating cash flows",
        "cash flows from operating",
        "cash flow from operating",
        "operating cash"
      ]
    },
    {
      "id": "cash",
      "any": [
        "cash and cash equivalents",
        "cash and equivalents",
        "cash was",
        "cash were",
        "cash balance"
      ],
      "none": ["cash flow", "cash flows"]
    },
    {
      "id": "revenue_guide",
      "all_any": [
        ["guidance", "outlook"],
        ["revenue", "revenues", "sales", "net sales"]
      ],
      "none": [
        "cash and cash equivalents",
        "cash and equivalents",
        "cash was",
        "cash were",
        "cash balance",
        "cash flow",
        "cash flows"
      ]
    },
    {
      "id": "concentration",
      "any": [
        "largest customer",
        "customer concentration",
        "percent of revenue from",
        "% of revenue from",
        "no customer accounted"
      ]
    },
    {
      "id": "net_interest_income",
      "any": ["net interest income"]
    },
    {
      "id": "credit_loss_provision",
      "any": ["provision for credit", "credit loss", "credit losses"]
    },
    {
      "id": "gross_margin",
      "any": ["gross margin", "gross margins"]
    },
    {
      "id": "operating_income",
      "any": ["operating income", "operating profit", "operating loss", "operating losses"]
    },
    {
      "id": "net_income",
      "any": ["net income", "net loss", "net losses", "net earnings"]
    },
    {
      "id": "rnd_expense",
      "any": ["research and development", "r&d"]
    },
    {
      "id": "rpo_backlog",
      "any": [
        "remaining performance obligation",
        "remaining performance obligations",
        "rpo",
        "rpos",
        "backlog",
        "backlogs"
      ]
    },
    {
      "id": "purchase_commitments",
      "any": [
        "purchase commitment",
        "purchase commitments",
        "purchase obligation",
        "purchase obligations",
        "supply commitment",
        "supply commitments",
        "capacity agreement",
        "capacity agreements",
        "long-term supply",
        "long-term purchase"
      ]
    },
    {
      "id": "capex",
      "any": [
        "capital expenditure",
        "capital expenditures",
        "purchases of property",
        "capex"
      ]
    },
    {
      "id": "long_term_debt",
      "any": ["long-term debt", "long term debt", "notes payable", "convertible notes"]
    },
    {
      "id": "diluted_shares",
      "any": [
        "diluted share",
        "diluted shares",
        "weighted-average share",
        "weighted-average shares",
        "share count"
      ]
    },
    {
      "id": "guarantees",
      "any": [
        "guarantee",
        "guarantees",
        "guaranty",
        "guaranties",
        "indemnity",
        "indemnities",
        "indemnification",
        "indemnifications"
      ]
    },
    {
      "id": "share_repurchase",
      "any": [
        "share repurchase",
        "share repurchases",
        "stock repurchase",
        "stock repurchases",
        "buyback",
        "buybacks"
      ]
    },
    {
      "id": "dividends",
      "any": ["dividend", "dividends"]
    },
    {
      "id": "export_controls",
      "any": [
        "export control",
        "export controls",
        "export restriction",
        "export restrictions",
        "sanction",
        "sanctions",
        "embargo",
        "embargoes"
      ]
    },
    {
      "id": "company_revenue",
      "any": [
        "net sales",
        "total revenue",
        "total revenues",
        "operating revenue",
        "operating revenues",
        "premiums earned",
        "rental revenue",
        "rental revenues",
        "collaboration revenue",
        "collaboration revenues"
      ],
      "regex": "\\b(?:consolidated(?: net)? revenues?|company revenue|(?:q[1-4]|fy\\d{4}|fiscal year \\d{4})(?:\\s+fy\\d{4})?\\s+revenues? (?:was|were|of))\\b",
      "none": [
        "guidance",
        "outlook",
        "deferred",
        "largest customer",
        "customer concentration",
        "percent of revenue from",
        "% of revenue from",
        "no customer accounted"
      ]
    },
    {
      "id": "headcount",
      "any": ["number of employees"],
      "regex": "\\b\\d[\\d,]*(?:\\.\\d+)?\\s+thousand\\s+employees\\b",
      "requires_count": true
    },
    {
      "id": "operating_segments",
      "any": [
        "operating segment",
        "operating segments",
        "reportable segment",
        "reportable segments"
      ],
      "requires_count": true
    }
  ],
  "risk_metric": [
    ["goodwill impairment", "goodwill_impairment"],
    ["impairment", "impairment"],
    ["impairments", "impairment"],
    ["inventory", "inventory"],
    ["inventories", "inventory"],
    ["cash flow", "operating_cash_flow"],
    ["cash flows", "operating_cash_flow"],
    ["operating cash", "operating_cash_flow"],
    ["cash", "cash"],
    ["gross margin", "gross_margin"],
    ["margin", "gross_margin"],
    ["margins", "gross_margin"],
    ["concentration", "concentration"],
    ["customer", "concentration"],
    ["purchase commitments", "purchase_commitments"],
    ["purchase commitment", "purchase_commitments"],
    ["purchase obligations", "purchase_commitments"],
    ["purchase obligation", "purchase_commitments"],
    ["commitments", "purchase_commitments"],
    ["commitment", "purchase_commitments"],
    ["supply", "purchase_commitments"],
    ["debt", "long_term_debt"],
    ["convertible", "long_term_debt"],
    ["leverage", "long_term_debt"],
    ["export control", "export_controls"],
    ["export", "export_controls"],
    ["sanction", "export_controls"],
    ["sanctions", "export_controls"],
    ["embargo", "export_controls"],
    ["indemnification", "guarantees"],
    ["indemnity", "guarantees"],
    ["guarantee", "guarantees"],
    ["guarantees", "guarantees"],
    ["guaranty", "guarantees"],
    ["remaining performance obligations", "rpo_backlog"],
    ["remaining performance obligation", "rpo_backlog"],
    ["performance obligation", "rpo_backlog"],
    ["backlog", "rpo_backlog"],
    ["capital expenditures", "capex"],
    ["capital expenditure", "capex"],
    ["capex", "capex"],
    ["repurchase", "share_repurchase"],
    ["buyback", "share_repurchase"],
    ["dividends", "dividends"],
    ["dividend", "dividends"],
    ["credit loss", "credit_loss_provision"],
    ["research and development", "rnd_expense"],
    ["r&d", "rnd_expense"],
    ["goodwill", "goodwill"]
  ]
}
